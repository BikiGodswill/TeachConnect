NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider (see lib/payments/provider.js). Webhook secret is server only.
# PAYMENT_WEBHOOK_SECRET=

# Optional: social links in the footer (a button appears only when set)
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Support email shown on the Contact page
# NEXT_PUBLIC_SUPPORT_EMAIL=
# PAYMENT_PROVIDER=mock   # mock is blocked in production

# Phase 2
# Local emergency number shown next to the SOS button (e.g. your country's police/ambulance line). Not hard-coded.
# NEXT_PUBLIC_EMERGENCY_NUMBER=

# Phase 3
# Public site address, used in certificate verification links and QR codes (e.g. https://teacherconnect.example)
# NEXT_PUBLIC_SITE_URL=
# Video classroom (Jitsi). meet.jit.si is for trying things out; use a self-hosted Jitsi or JaaS in production.
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# AI assistant (off unless both are set; AI_MODEL is a model id from your Anthropic account). Daily cap per user is in platform_settings.ai_daily_limit.
# ANTHROPIC_API_KEY=
# AI_MODEL=

# E-mail notifications (see docs/EMAIL.md)
# RESEND_API_KEY=            # from resend.com (server only)
# EMAIL_FROM=Teacher Connect <notifications@yourdomain.com>   # an address on a domain you verified in Resend
# EMAIL_REPLY_TO=
# CRON_SECRET=               # any long random string; the sender route refuses calls without it
